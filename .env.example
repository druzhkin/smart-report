# ============================================================
# LLM Gateway — все запросы через OpenRouter (кроме Perplexity)
# ============================================================
OPENROUTER_API_KEY=sk-or-v1-...          # https://openrouter.ai/keys
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ============================================================
# Direct APIs — не проксируются через OpenRouter
# ============================================================
PERPLEXITY_API_KEY=pplx-...              # https://perplexity.ai/settings/api — sonar-deep-research
DEEPGRAM_API_KEY=...                     # https://console.deepgram.com — транскрипция аудио
GAMMA_API_KEY=...                        # https://gamma.app — облачная генерация презентаций (опционально)

# ============================================================
# Observability — LangSmith трейсинг всех агентов
# ============================================================
LANGSMITH_API_KEY=lsv2_pt_...           # https://smith.langchain.com/settings
LANGCHAIN_TRACING_V2=true               # включить трейсинг (false для prod без трейсинга)
LANGCHAIN_PROJECT=smart-report          # имя проекта в LangSmith UI

# ============================================================
# Knowledge Library — RAGFlow для векторного поиска
# ============================================================
RAGFLOW_API_KEY=ragflow-...             # Bearer-токен из панели RAGFlow
RAGFLOW_BASE_URL=http://localhost:9380  # self-hosted RAGFlow endpoint

# ============================================================
# Database
# ============================================================
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/smart_report
REDIS_URL=redis://localhost:6379        # кеш + очереди задач

# ============================================================
# Storage
# ============================================================
OUTPUTS_DIR=./outputs                   # директория для готовых отчётов и артефактов

# ============================================================
# Runtime
# ============================================================
DEV_MODE=false
ENABLE_APO_SCHEDULER=true

# ============================================================
# Budget Limits (USD) — максимальный расход на один запрос
# ============================================================
BUDGET_LIGHT=0.50         # быстрый режим (2-3 агента)
BUDGET_STANDARD=2.00      # стандартный (все агенты, без deep research)
BUDGET_DEEP=5.00          # глубокий (Perplexity sonar-deep-research включён)
BUDGET_EXHAUSTIVE=15.00   # исчерпывающий (все источники, максимальные модели)

# ============================================================
# Public Site Pricing (USD) - цена для показа на сайте
# ============================================================
PUBLIC_PRICE_LIGHT=0.50
PUBLIC_PRICE_STANDARD=2.00
PUBLIC_PRICE_DEEP=5.00
PUBLIC_PRICE_EXHAUSTIVE=15.00

# ============================================================
# Presentation Engine
# ============================================================
PRESENTON_URL=http://localhost:5000     # self-hosted Presenton (приоритет)
# GAMMA_API_KEY выше используется как fallback для облачной генерации

# ============================================================
# Push Notifications (Web Push / VAPID)
# ============================================================
NEXT_PUBLIC_VAPID_KEY=...               # публичный VAPID ключ (передаётся на фронт)
VAPID_PRIVATE_KEY=...                   # приватный VAPID ключ (только бэкенд, не коммитить!)
